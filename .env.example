OPENAI_API_KEY=sk-...
# Optional — point the chat proxy to any OpenAI-compatible provider (default: OpenAI).
# LLM_CHAT_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_API_KEY=gsk_...
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
REDIS_URL=redis://localhost:6379
DEFAULT_QUOTA_LIMIT=100000
QUOTA_WINDOW_SECONDS=3600

# Required — the gateway refuses to start without it.
# Comma-separated <api_key>:<tenant_id> pairs. An API key cannot contain a colon and cannot repeat.
# GATEWAY_API_KEYS=<api_key>:<tenant_id>,<api_key>:<tenant_id>

# Temporary migration aid, off by default. Only the exact value 1 enables it.
# While enabled, requests without a Bearer token are accepted if X-Tenant-ID names a configured tenant,
# so any client can impersonate any tenant. Remove it as soon as clients send API keys.
# GATEWAY_LEGACY_TENANT_HEADER=1
